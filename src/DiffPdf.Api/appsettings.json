{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "DiffPdf.Api"
    }
  },
  "Auth": {
    "Enabled": false,
    "ClientId": "diffpdf-ci",
    "ClientSecret": "diffpdf-secret",
    "Scope": "diffpdf.api",
    "AccessTokenMinutes": 60
  },
  "Network": {
    "AllowInlineCredentials": true,
    "MountReadOnly": true,
    "CredentialProfiles": {
      // "corp": { "username": "svc_diff", "password": "…", "domain": "CORP" }
    },
    "Shares": {
      // "reports":  { "root": "\\\\fileserver\\reports", "credentialProfile": "corp", "description": "Print-report shares" },
      // "baseline": { "localMountPath": "/mnt/reports", "description": "Pre-mounted on every worker" }
    }
  },
  "Notifications": {
    // Only the e-mail transport / base URL live here. Subscriptions are managed at runtime
    // via the API (POST /api/v1/subscriptions), and schedules via
    // POST /api/v1/branches/{branch}/instances/{instance}/schedules — both persisted, no restart.
    "BaseUrl": "http://localhost:8080"
    // "Smtp": { "Host": "smtp.corp", "Port": 587, "UseSsl": true, "Username": "svc", "Password": "…", "From": "diffpdf@corp" }
  },
  "Retention": {
    // Prune the on-disk report folder of finished jobs older than RetentionDays (DB rows + run
    // history are kept). Leader-gated; disabled by default.
    "Enabled": false,
    "RetentionDays": 30,
    "IntervalHours": 6
  },
  "ScopeSync": {
    // Reconcile a <root>/<branch>/<instance>/{old,new,reports} tree with the DB scope model:
    // register folders found on disk, create missing folders, report differences. Leader-gated;
    // the background sync is disabled by default. The on-demand endpoint POST /api/v1/scope/sync
    // works regardless (dry-run by default, ?apply=true to act).
    "Enabled": false,
    "RootPath": "",
    // "CredentialProfile": "corp",
    "IntervalSeconds": 300,
    "AutoRegister": true,
    "AutoCreateFolders": true
  },
  "DefaultAutomation": {
    // When an instance is registered for the first time (via scope sync or POST .../instances), provision
    // a default schedule + folder-watch as DISABLED templates an operator can enable later, and optionally
    // fire one initial trigger run. Disabled by default, so existing deployments are unaffected.
    "Enabled": false,
    "CreateSchedule": true,
    "ScheduleKey": "default",
    "ScheduleCron": "0 2 * * *",
    "CreateWatch": true,
    "WatchStabilitySeconds": 30,
    "FireInitialTrigger": true
  },
  "AllowedHosts": "*"
}
