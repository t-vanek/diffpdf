{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "DiffPdf.Api"
    }
  },
  "Auth": {
    "Enabled": false,
    "ClientId": "diffpdf-ci",
    "ClientSecret": "diffpdf-secret",
    "Scope": "diffpdf.api",
    "AccessTokenMinutes": 60
  },
  "ConnectionStrings": {
    // Empty = in-memory dev fallback. Override in appsettings.Development.json,
    // appsettings.Production.json or with ConnectionStrings__SqlServer.
    "SqlServer": ""
  },
  "Network": {
    "AllowInlineCredentials": true,
    "MountReadOnly": true,
    "CredentialProfiles": {
      // "corp": { "username": "svc_diff", "password": "…", "domain": "CORP" }
    },
    "Shares": {
      // "reports":  { "root": "\\\\fileserver\\reports", "credentialProfile": "corp", "description": "Print-report shares" },
      // "baseline": { "localMountPath": "/mnt/reports", "description": "Pre-mounted on every worker" }
    }
  },
  "Notifications": {
    // E-mail rules AND the SMTP transport are managed at runtime via the API (persisted, no restart):
    // rules at /api/v1/subscriptions, SMTP at /api/v1/settings/email (Konfigurace → E-mail in the desktop app).
    // BaseUrl builds deep links into notification bodies. The Smtp block below is only a fallback, honored until
    // SMTP settings are saved from the UI.
    "BaseUrl": "http://localhost:8080"
    // "Smtp": { "Host": "smtp.corp", "Port": 587, "UseSsl": true, "Username": "svc", "Password": "…", "From": "diffpdf@corp" }
  },
  "Automation": {
    // The automation engine. Automations (triggers — cron/interval, domain events, manual — plus an ordered
    // step pipeline with timeout/retry/escalation) are runtime resources managed via POST /api/v1/automations;
    // the tick cadence, run parallelism and auto-provision defaults live here. A legacy "ControlPlane" section
    // is still honored when this one is absent.
    "TickSeconds": 20,
    "MaxConcurrentRuns": 4,
    // Auto-provisioning of the standard automations: a per-branch readiness automation when a branch is created,
    // and the server-wide baseline (health, retention, db-row-retention, + structure-sync when ScopeSync:RootPath
    // is set) plus existing branches at startup. Idempotent and non-destructive — it never overwrites an
    // automation you edit. Works as-is; override only what you want. Set Enabled=false to turn it off
    // (or ?autoProvision=false per create call).
    "AutoProvision": {
      "Enabled": true,
      "ReadinessIntervalSeconds": 300,
      "HealthIntervalSeconds": 60,
      "RetentionCron": "0 3 * * *",
      "RetentionDays": 30,
      "StructureSyncIntervalSeconds": 900
    }
  },
  "Discovery": {
    // LAN auto-discovery: the server answers UDP broadcast probes on this port so the desktop client
    // can find it without a hardcoded address. Set Enabled=false to turn it off; Port must match the client.
    "Enabled": true,
    "Port": 5276
  },
  "FileManager": {
    // PDF file manager (desktop "Správa souborů" page). RootPath is the managed subtree; empty → falls back
    // to ScopeSync:RootPath, so the manager operates over the same <branch>/<instance>/{old,new,reports}
    // tree the comparisons read. Clients only ever see root-relative paths.
    "RootPath": "",
    "MaxUploadSizeMB": 256,
    "ValidatePdfMagicBytes": true,
    "MaxSearchResults": 500
  },
  "ScopeSync": {
    // Structure root. Branches/instances are created under it as <root>/<branch>/<instance>/{old,new,reports}:
    // creating a branch makes <root>/<branch>, creating an instance derives its base path from it server-side.
    // Also drives the StructureSync automation and POST /api/v1/scope/sync. Empty = feature off (the instance
    // create then requires an explicit base path). Override per environment/machine as needed.
    "RootPath": "D:\\diffpdf",
    // "CredentialProfile": "corp",
    "AutoRegister": true,
    "AutoCreateFolders": true
  },
  "AllowedHosts": "*"
}
