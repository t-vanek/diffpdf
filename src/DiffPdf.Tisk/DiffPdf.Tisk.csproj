<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The D3Soft proxy assemblies are net472-era and not nullable-annotated; don't let
         their nullability noise fail our build. Our own code is still null-checked. -->
    <NoWarn>$(NoWarn);CS8601;CS8602;CS8603;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The print-SOA abstractions (IPrintBatchService + DTOs) this assembly implements. -->
    <ProjectReference Include="..\DiffPdf.Application.Abstractions\DiffPdf.Application.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private D3S feed (see repo-root nuget.config). These pull in the D3Soft.Tisk /
         D3Soft.Auth print-SOA proxies and their transitive D3Soft.* dependencies. -->
    <PackageReference Include="D3Soft.Tisk.Shared" Version="10.2.0.13" />
    <PackageReference Include="D3Soft.Lib.Server" Version="10.3.0.4" />
    <PackageReference Include="D3Soft.Identifier.Shared" Version="10.2.0.12" />
  </ItemGroup>

</Project>
