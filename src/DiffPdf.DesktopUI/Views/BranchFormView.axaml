<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.BranchFormView"
             x:DataType="vm:BranchFormViewModel">

  <StackPanel Margin="18" Spacing="12">
    <TextBlock Text="{Binding WindowTitle}" Classes="headline"/>

    <StackPanel Spacing="4">
      <TextBlock Text="Klíč" Foreground="{DynamicResource InkDim}"/>
      <TextBox x:Name="KeyBox" Text="{Binding Key}" PlaceholderText="Klíč (např. Alfa)" IsEnabled="{Binding !IsEditMode}"/>
      <TextBlock Text="Klíč je neměnná identita a po vytvoření ho nelze změnit."
                 Foreground="{DynamicResource InkFaint}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsEditMode}"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Název" Foreground="{DynamicResource InkDim}"/>
      <TextBox x:Name="NameBox" Text="{Binding Name}" PlaceholderText="Název"/>
    </StackPanel>

    <CheckBox Content="Povoleno" IsChecked="{Binding Enabled}" IsVisible="{Binding IsEditMode}"/>

    <TextBlock Foreground="{DynamicResource Info}" TextWrapping="Wrap"
               Text="{Binding FolderPreview, StringFormat='Složka větve vznikne v: {0}'}"
               IsVisible="{Binding FolderPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap"
               IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Ellipse Classes="spinner" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
      <Button Content="{Binding SaveButtonText}" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="100"
              IsEnabled="{Binding !IsBusy}"/>
      <Button Content="Zrušit" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80"/>
    </StackPanel>
  </StackPanel>
</UserControl>
