<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
        xmlns:services="using:DiffPdf.DesktopUI.Services"
        x:Class="DiffPdf.DesktopUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="820"
        Title="DiffPDF Remote Manager">

  <Panel>
  <DockPanel>
    <!-- Header: title · connection status · connection gear (server config lives in the gear, not a top bar) -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#252526">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="DiffPDF Remote Manager" FontWeight="Bold" FontSize="14"
                   Foreground="White" VerticalAlignment="Center"/>

        <!-- Live connection status -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
          <Ellipse Width="9" Height="9" Fill="#6FCF73" VerticalAlignment="Center" Classes="pulse" IsVisible="{Binding IsConnected}"/>
          <Ellipse Width="9" Height="9" Fill="#888888" VerticalAlignment="Center" IsVisible="{Binding !IsConnected}"/>
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="#9CDCFE" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip.Tip="{Binding ConnectionStatus}"/>
        </StackPanel>

        <!-- Connection gear: configure / connect / remember -->
        <Button Grid.Column="2" VerticalAlignment="Center" Padding="8,4" ToolTip.Tip="Připojení k serveru">
          <TextBlock Text="⚙" FontSize="16"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="330" Spacing="8" Margin="4" x:CompileBindings="False">
                <TextBlock Text="Připojení k serveru" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Adresa serveru" FontSize="12" Foreground="#AAAAAA"/>
                <TextBox Text="{Binding ServerUrl}" PlaceholderText="http://localhost:5275"/>
                <StackPanel Spacing="6" IsVisible="{Binding AuthEnabled}">
                  <TextBox Text="{Binding ClientId}" PlaceholderText="ClientId"/>
                  <TextBox Text="{Binding ClientSecret}" PlaceholderText="Secret" PasswordChar="•"/>
                </StackPanel>
                <CheckBox Content="Připojovat automaticky při startu" IsChecked="{Binding AutoConnect}"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Připojit" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}"/>
                  <Button Content="Odpojit" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"/>
                  <Button Content="💾 Uložit" Command="{Binding SaveSettingsCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#9CDCFE" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SaveNote}" Foreground="#6FCF73" TextWrapping="Wrap"
                           IsVisible="{Binding SaveNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding Error}" Foreground="#FF6B6B" TextWrapping="Wrap"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Nav rail -->
    <ListBox DockPanel.Dock="Left" Width="210"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage}"
             IsEnabled="{Binding IsConnected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PageViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4">
            <TextBlock Text="{Binding Icon}" FontSize="15" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Active page when connected; a clear "not connected" panel otherwise (instead of a blank screen). -->
    <Panel Margin="10">
      <TransitioningContentControl Content="{Binding SelectedPage}" IsVisible="{Binding IsConnected}">
        <TransitioningContentControl.PageTransition>
          <PageSlide Duration="0:0:0.22" Orientation="Horizontal"/>
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>

      <Border Classes="fadeIn" IsVisible="{Binding !IsConnected}" Background="#232327" BorderBrush="#36363D" BorderThickness="1"
              CornerRadius="8" Padding="28" MaxWidth="470" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="⚠" FontSize="34" Foreground="#D8A657" HorizontalAlignment="Center"/>
          <TextBlock Text="Nepřipojeno k serveru" FontSize="18" FontWeight="Bold" Foreground="#ECECEC" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="#9CDCFE"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Error}" Foreground="#E06C75"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Button Content="Připojit" Command="{Binding ConnectCommand}" HorizontalAlignment="Center" Padding="16,6"
                  IsVisible="{Binding !IsBusy}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsBusy}">
            <Ellipse Classes="spinner"/>
            <TextBlock Text="Připojuji…" Foreground="#9CDCFE" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Adresu serveru a přihlášení upravíš přes ⚙ vpravo nahoře."
                     Foreground="#76767E" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>

    <!-- Toast overlay (bottom-right); items auto-dismiss after a few seconds. -->
    <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="16" ZIndex="100">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:ToastItem">
          <Border Classes="fadeIn" Background="#2A2A30" BorderBrush="{Binding Accent}" BorderThickness="1"
                  CornerRadius="6" MinWidth="220" MaxWidth="380" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Border Width="4" Background="{Binding Accent}"/>
              <TextBlock Text="{Binding Message}" Foreground="#ECECEC" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="12,10"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</Window>
