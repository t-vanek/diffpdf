<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:views="using:DiffPdf.DesktopUI.Views"
             xmlns:conv="using:DiffPdf.DesktopUI.Converters"
             x:Class="DiffPdf.DesktopUI.Views.ScopeSettingsView"
             x:DataType="vm:ScopeSettingsViewModel">

  <Grid RowDefinitions="*,Auto" Margin="4">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="Bold"/>

        <!-- Trigger Settings -->
        <Border Classes="cardStatic" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Konfigurace spouštěčů" FontWeight="Bold" FontSize="14"/>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSourceSelectable}">
              <TextBlock Text="Zdroj konfigurace:" VerticalAlignment="Center"/>
              <ComboBox MinWidth="200" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding TriggerSource}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding Converter={x:Static conv:ConfigSourceLabelConverter.Instance}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding TriggerSourceInfo}" Foreground="{DynamicResource Info}"
                       IsVisible="{Binding TriggerSourceInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <StackPanel Spacing="8" IsVisible="{Binding TriggerFieldsVisible}">
              <WrapPanel>
                <StackPanel Width="240" Margin="0,0,8,6">
                  <TextBlock Text="Vzor souborů"/>
                  <TextBox Text="{Binding SearchPattern}"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,8,6">
                  <TextBlock Text="Max. paralelismus (0 = auto)"/>
                  <NumericUpDown Value="{Binding MaxDegreeOfParallelism}" Minimum="0" Maximum="64" Increment="1" FormatString="0"/>
                </StackPanel>
              </WrapPanel>
              <CheckBox Content="Rekurzivně (včetně podsložek)" IsChecked="{Binding Recursive}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Comparer Settings -->
        <Border Classes="cardStatic" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Konfigurace porovnávačů" FontWeight="Bold" FontSize="14"/>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSourceSelectable}">
              <TextBlock Text="Zdroj konfigurace:" VerticalAlignment="Center"/>
              <ComboBox MinWidth="200" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding ComparerSource}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding Converter={x:Static conv:ConfigSourceLabelConverter.Instance}}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding ComparerSourceInfo}" Foreground="{DynamicResource Info}"
                       IsVisible="{Binding ComparerSourceInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <ContentControl IsVisible="{Binding ComparerFieldsVisible}">
              <views:ComparisonOptionsEditor DataContext="{Binding Comparer}"/>
            </ContentControl>
          </StackPanel>
        </Border>

        <!-- Scheduled run (cron) — branch / instance only -->
        <Border Classes="cardStatic" Padding="12" IsVisible="{Binding IsScheduleAvailable}">
          <StackPanel Spacing="8">
            <TextBlock Text="Plán běhu" FontWeight="Bold" FontSize="14"/>
            <CheckBox Content="Spouštět automaticky podle plánu" IsChecked="{Binding ScheduleEnabled}"/>
            <StackPanel Width="240" IsEnabled="{Binding ScheduleEnabled}">
              <TextBlock Text="Cron (UTC, 5 polí)"/>
              <TextBox Text="{Binding ScheduleCron}" PlaceholderText="0 6 * * *"/>
            </StackPanel>
            <TextBlock Text="Formát: minuta hodina den měsíc den-v-týdnu (UTC). Např. „0 6 * * *“ = každý den v 6:00 UTC. Spuštěné instance se zařadí do fronty větve a poběží postupně."
                       Foreground="{DynamicResource Info}" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Good}"
                   IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
      <Button Content="Uložit" Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"/>
      <Button Content="Zavřít" Command="{Binding CancelCommand}" IsVisible="{Binding IsModal}"/>
    </StackPanel>
  </Grid>
</UserControl>
