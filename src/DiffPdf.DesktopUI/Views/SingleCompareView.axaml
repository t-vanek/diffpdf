<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:views="using:DiffPdf.DesktopUI.Views"
             xmlns:controls="using:DiffPdf.DesktopUI.Controls"
             x:Class="DiffPdf.DesktopUI.Views.SingleCompareView"
             x:DataType="vm:SingleCompareViewModel"
             DragDrop.AllowDrop="True">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <WrapPanel ItemSpacing="10" LineSpacing="8">
        <TextBlock Text="Jednorázové porovnání" Classes="pageTitle"/>
        <Button Content="Porovnat" Classes="accent" Command="{Binding CompareCommand}" VerticalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </WrapPanel>

      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stará verze" Classes="caption" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="OldPathBox" Text="{Binding OldPath}"
                 PlaceholderText="cesta k PDF (stará verze) — nebo sem přetáhni soubor"/>
        <Button Grid.Row="0" Grid.Column="2" Classes="ghost" Content="Procházet…" Command="{Binding BrowseOldCommand}"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nová verze" Classes="caption" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewPathBox" Text="{Binding NewPath}"
                 PlaceholderText="cesta k PDF (nová verze) — nebo sem přetáhni soubor"/>
        <Button Grid.Row="1" Grid.Column="2" Classes="ghost" Content="Procházet…" Command="{Binding BrowseNewCommand}"/>
      </Grid>
    </StackPanel>

    <Grid ColumnDefinitions="2*,3*">
      <!-- Možnosti porovnání -->
      <Border Grid.Column="0" Margin="0,0,12,0" Classes="cardStatic" Padding="8">
        <ScrollViewer>
          <views:ComparisonOptionsEditor DataContext="{Binding Options}"/>
        </ScrollViewer>
      </Border>

      <!-- Výsledek: verdikt + náhled vyhodnoceného diff PDF přímo ve WebView2 -->
      <Grid Grid.Column="1">
        <!-- Prázdný stav (před prvním porovnáním) -->
        <StackPanel IsVisible="{Binding !HasResult}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="320">
          <TextBlock Text="⇄" FontSize="36" Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center"/>
          <TextBlock Text="Zadej cesty ke dvěma PDF a klikni Porovnat. Zvýrazněný rozdíl se zobrazí přímo zde."
                     Foreground="{DynamicResource InkDim}" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Výsledek -->
        <DockPanel IsVisible="{Binding HasResult}">
          <Border DockPanel.Dock="Top" Classes="card fadeIn" BorderBrush="{Binding VerdictBrush}" Padding="20,14" Margin="0,0,0,10">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding VerdictBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" FontSize="20" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource InkDim}" FontSize="13"/>
            </StackPanel>
          </Border>

          <!-- Náhled diff PDF (WebView2/Edge) vyplní zbytek; u shodných dokumentů přátelský prázdný stav.
               (Nativní WebView2 nezaobluje rohy, proto rovný rámeček.) -->
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
            <Panel Background="{DynamicResource Bg}">
              <controls:WebView2Host Source="{Binding FileUri}" IsVisible="{Binding HasDiff}"/>
              <StackPanel IsVisible="{Binding !HasDiff}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="320">
                <TextBlock Text="✓" FontSize="36" Foreground="{DynamicResource Good}" HorizontalAlignment="Center"/>
                <TextBlock Text="Dokumenty jsou shodné — žádné rozdíly k zobrazení."
                           Foreground="{DynamicResource InkDim}" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Panel>
          </Border>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
