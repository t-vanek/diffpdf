<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.BatchGateEditor"
             x:DataType="vm:BatchGateViewModel">

  <StackPanel Spacing="6">
    <CheckBox Content="CI brána" IsChecked="{Binding Enabled}" FontWeight="Bold"/>
    <StackPanel Spacing="6" IsEnabled="{Binding Enabled}">
      <CheckBox Content="Selhat při jakémkoli rozdílu" IsChecked="{Binding FailOnAnyDifference}"/>
      <WrapPanel>
        <StackPanel Width="170" Margin="0,0,8,6">
          <TextBlock Text="Max. odlišných souborů"/>
          <NumericUpDown Value="{Binding MaxDifferingFiles}" Minimum="0" FormatString="0"/>
        </StackPanel>
        <StackPanel Width="150" Margin="0,0,8,6">
          <TextBlock Text="Max. chyb"/>
          <NumericUpDown Value="{Binding MaxErrors}" Minimum="0" FormatString="0"/>
        </StackPanel>
        <StackPanel Width="210" Margin="0,0,8,6">
          <TextBlock Text="Max. souborů s chybami obsahu"/>
          <NumericUpDown Value="{Binding MaxFilesWithContentErrors}" Minimum="0" FormatString="0"/>
        </StackPanel>
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
