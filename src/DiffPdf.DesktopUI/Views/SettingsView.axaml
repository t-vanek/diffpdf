<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:views="using:DiffPdf.DesktopUI.Views"
             x:Class="DiffPdf.DesktopUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <TabControl>
    <TabItem Header="Spouštěče a porovnávače">
      <views:ScopeSettingsView DataContext="{Binding Editor}"/>
    </TabItem>
    <TabItem Header="E-mail (SMTP)">
      <views:EmailSettingsView DataContext="{Binding Email}"/>
    </TabItem>
  </TabControl>
</UserControl>
