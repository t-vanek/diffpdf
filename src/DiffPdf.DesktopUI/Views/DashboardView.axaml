<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <ScrollViewer>
    <StackPanel Spacing="10">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Přehled systému" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Content="Obnovit" Command="{Binding RefreshCommand}"/>
        <CheckBox Content="Auto (5 s)" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock Text="Obecný technický stav serveru a prostředí. Statistiky úloh, kontrol, automatizací a porovnávání najdete v detailu konkrétní Větve nebo Instance."
                 Foreground="#888" TextWrapping="Wrap"/>

      <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Replika" FontWeight="Bold"/>
          <TextBlock Text="{Binding Status.Replica.WorkerInstanceId, StringFormat='Worker: {0}'}"/>
          <TextBlock Text="{Binding Status.Replica.Version, StringFormat='Verze aplikace: {0}'}"/>
          <TextBlock Text="{Binding Status.Replica.Environment, StringFormat='Prostředí: {0}'}"/>
          <TextBlock Text="{Binding Status.Replica.UptimeSeconds, StringFormat='Doba běhu (s): {0:N0}'}"/>
          <TextBlock Text="{Binding Healthy, StringFormat='Server běží: {0}'}"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Vedoucí replika (leader)" FontWeight="Bold"/>
          <TextBlock Text="{Binding Status.Leader.Owner, StringFormat='Vlastník: {0}'}"/>
          <TextBlock Text="{Binding Status.Leader.IsThisReplica, StringFormat='Tato replika vede: {0}'}"/>
          <TextBlock Text="{Binding Status.Leader.LeaseHealthy, StringFormat='Zápůjčka platná: {0}'}"/>
          <TextBlock Text="{Binding Status.Leader.ExpiresAt, Converter={x:Static vm:LocalTimeConverter.Instance}, ConverterParameter='Expirace:|dd.MM.yyyy HH:mm'}"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Závislosti (zdraví)" FontWeight="Bold"/>
          <TextBlock Text="{Binding Status.Dependencies.Database.Ok, StringFormat='Databáze OK: {0}'}"/>
          <TextBlock Text="{Binding Status.Dependencies.Database.Detail}" Foreground="#888"/>
          <TextBlock Text="{Binding Status.Dependencies.Renderer.Ok, StringFormat='Renderer OK: {0}'}"/>
          <TextBlock Text="{Binding Status.Dependencies.Renderer.Detail}" Foreground="#888"/>
          <TextBlock Text="{Binding Status.Dependencies.Storage.Ok, StringFormat='Úložiště OK: {0}'}"/>
          <TextBlock Text="{Binding Status.Dependencies.Storage.Detail}" Foreground="#888"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Běžící služby (heartbeat této repliky)" FontWeight="Bold"/>
      <DataGrid x:CompileBindings="False" ItemsSource="{Binding Status.Services}" IsReadOnly="True"
                AutoGenerateColumns="False" Height="170" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Služba" Binding="{Binding Service}" Width="140"/>
          <DataGridTextColumn Header="Poslední tik" Binding="{Binding LastTickAt, Converter={x:Static vm:LocalTimeConverter.Instance}}" Width="200"/>
          <DataGridTextColumn Header="Tik leadera" Binding="{Binding LastLeaderActiveAt, Converter={x:Static vm:LocalTimeConverter.Instance}}" Width="200"/>
          <DataGridTextColumn Header="Tiků" Binding="{Binding TickCount}" Width="80"/>
          <DataGridTextColumn Header="Poslední chyba" Binding="{Binding LastError}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Připravenost závislostí" FontWeight="Bold"/>
      <DataGrid x:CompileBindings="False" ItemsSource="{Binding Readiness.Checks}" IsReadOnly="True"
                AutoGenerateColumns="False" Height="120" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Závislost" Binding="{Binding Name}" Width="140"/>
          <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="80"/>
          <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
