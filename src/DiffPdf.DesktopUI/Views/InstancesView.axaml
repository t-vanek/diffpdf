<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:models="using:DiffPdf.Client"
             x:Class="DiffPdf.DesktopUI.Views.InstancesView"
             x:DataType="vm:InstancesViewModel"
             x:Name="Root">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Instance" Classes="pageTitle" Margin="2,0,0,10"/>

    <!-- Toolbar: branch selector · primary action · bulk group · search. Wraps on narrow windows. Obnovení je
         implicitní (znovu-klik na položku navigace, kliknutí do řádku, nebo F5). -->
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <TextBlock Text="Větev:" Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"/>
      <ComboBox Width="180" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}">
        <ComboBox.ItemTemplate><DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Key}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Vytvořit instanci" Classes="accent" Command="{Binding ShowCreateCommand}"/>
      <Button Content="Smazat instanci" Classes="destructive" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>

      <Border Width="1" Background="{DynamicResource Line}" Margin="4,3"/>

      <Button Content="Povolit" Classes="ghost" Command="{Binding EnableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Povolí všechny zaškrtnuté instance"/>
      <Button Content="Zakázat" Classes="ghost" Command="{Binding DisableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Zakáže všechny zaškrtnuté instance"/>
      <Button Content="{Binding SelectedDeleteCount, StringFormat='Smazat vybrané ({0})'}" Classes="destructive"
              Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Smaže všechny zaškrtnuté instance"/>

      <TextBox x:Name="SearchBox" Width="200" VerticalAlignment="Center" Text="{Binding SearchText}"
               PlaceholderText="Hledat (klíč/název/cesta)…" ToolTip.Tip="Hledat (Ctrl+F)"/>
      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </WrapPanel>

    <Grid ColumnDefinitions="3*,2*">
      <DataGrid Grid.Column="0" Margin="0,0,12,0" x:CompileBindings="False" Tapped="OnRowTapped" ItemsSource="{Binding InstancesView}"
                SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <CheckBox IsChecked="{Binding #Root.DataContext.AllSelected, Mode=TwoWay}" ToolTip.Tip="Vybrat / odznačit vše"/>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="10,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="Vybrat pro hromadné smazání"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="✎" Classes="iconBtn ghost" ToolTip.Tip="Upravit instanci"
                          Command="{Binding #Root.DataContext.EditInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⚙&#xFE0E;" Classes="iconBtn ghost" ToolTip.Tip="Konfigurace (triggery a porovnávače)"
                          Command="{Binding #Root.DataContext.OpenSettingsCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Akce" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="▸" Classes="iconBtn ghost" ToolTip.Tip="Spustit" IsEnabled="{Binding CanRun}"
                          Command="{Binding #Root.DataContext.RunInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="+" Classes="iconBtn ghost" ToolTip.Tip="Přidat do fronty" IsEnabled="{Binding CanEnqueue}"
                          Command="{Binding #Root.DataContext.EnqueueInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="‖" Classes="iconBtn ghost" ToolTip.Tip="Pozastavit" IsEnabled="{Binding CanPause}"
                          Command="{Binding #Root.DataContext.PauseInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="↻" Classes="iconBtn ghost" ToolTip.Tip="Obnovit" IsEnabled="{Binding CanResume}"
                          Command="{Binding #Root.DataContext.ResumeInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="■" Classes="iconBtn ghost" ToolTip.Tip="Zastavit" IsEnabled="{Binding CanStop}"
                          Command="{Binding #Root.DataContext.StopInstanceCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Klíč" Binding="{Binding Instance.Key}" Width="140"/>
          <DataGridTextColumn Header="Název" Binding="{Binding Instance.Name}" Width="140"/>
          <DataGridTextColumn Header="Základní cesta" Binding="{Binding Instance.BasePath}" Width="*"/>
          <DataGridTemplateColumn Header="Aktivní" Width="110" SortMemberPath="Instance.Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border Classes="badge good" IsVisible="{Binding Instance.Enabled}">
                    <TextBlock Text="Povoleno"/>
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding !Instance.Enabled}">
                    <TextBlock Text="Zakázáno"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Fronta" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Info}" IsVisible="{Binding IsActive}"/>
                  <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource InkFaint}" IsVisible="{Binding !IsActive}"/>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Prázdný stav (přes prázdnou mřížku) -->
      <TextBlock Grid.Column="0" Margin="0,0,12,0" TextWrapping="Wrap"
                 Text="Žádné instance. Vyber větev nahoře, nebo vytvoř instanci přes „Vytvořit instanci“."
                 Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding HasNoInstances}"/>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
          <TextBlock Text="Vyber instanci v seznamu pro zobrazení stavu a statistik."
                     Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"
                     IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNull}}"/>

          <StackPanel Spacing="10" IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding SelectedInstance}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="models:Instance">
                  <TextBlock Text="{Binding Key, StringFormat='Detail instance: {0}'}" Classes="headline"/>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Statistiky této instance -->
            <ItemsControl ItemsSource="{Binding Stats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatGroup">
                  <Border Classes="cardStatic" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatLine">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                              <TextBlock Grid.Column="0" Width="18" Text="{Binding Icon}" Foreground="{Binding Foreground}"/>
                              <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding Foreground}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{Binding Foreground}" FontWeight="{Binding Weight}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Připravenost — gated via ContentControl so the inner bindings never fire when ReadinessDisplay is null. -->
            <ContentControl Content="{Binding ReadinessDisplay}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ReadinessView">
                  <Border Classes="cardStatic" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Připravenost" FontWeight="SemiBold"/>

                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      </StackPanel>

                      <TextBlock Text="Složky" Foreground="{DynamicResource InkDim}" FontSize="12" Margin="0,4,0,0"/>
                      <SelectableTextBlock Text="{Binding BasePath}" Foreground="{DynamicResource InkFaint}" FontSize="11" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderLine">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="●" Foreground="{Binding Dot}" Margin="0,0,6,0"/>
                              <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Párování" Foreground="{DynamicResource InkDim}" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding HasPairing}"/>
                      <Border Height="6" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource NeutralFill}" HorizontalAlignment="Left"
                              IsVisible="{Binding HasPairing}">
                        <ItemsControl ItemsSource="{Binding Bar}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarSegment">
                              <Border Width="{Binding Width}" Background="{Binding Brush}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Pairing}" IsVisible="{Binding HasPairing}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PairingLine">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                              <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" Width="14"/>
                              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
