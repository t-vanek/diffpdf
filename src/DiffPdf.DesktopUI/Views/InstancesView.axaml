<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.InstancesView"
             x:DataType="vm:InstancesViewModel"
             x:Name="Root">

  <DockPanel>
    <!-- Toolbar: výběr větve + akce -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Instance" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="Větev:" VerticalAlignment="Center"/>
      <ComboBox Width="180" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}">
        <ComboBox.ItemTemplate><DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Key}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="🔄 Obnovit" Command="{Binding RefreshCommand}"/>
      <Button Content="➕ Vytvořit instanci" Command="{Binding ShowCreateCommand}"/>
      <Button Content="🗑 Smazat instanci" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="#9CDCFE" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </StackPanel>

    <!-- Reveal create form -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowCreateForm}"
            BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
      <StackPanel Spacing="8">
        <TextBlock Text="Nová instance" FontWeight="Bold"/>
        <WrapPanel>
          <TextBox Width="180" Margin="0,0,8,6" Text="{Binding NewKey}" PlaceholderText="Klíč (např. LamaEnergy)"/>
          <TextBox Width="200" Margin="0,0,8,6" Text="{Binding NewName}" PlaceholderText="Název"/>
          <TextBox Width="320" Margin="0,0,8,6" Text="{Binding NewRoot}" PlaceholderText="Kořenová složka (např. D:\diffpdf)"
                   IsVisible="{Binding RootInputVisible}"/>
          <TextBox Width="220" Margin="0,0,8,6" Text="{Binding NewCredentialProfile}" PlaceholderText="Profil přihlášení (volitelné)"/>
        </WrapPanel>
        <TextBlock Foreground="#808080" TextWrapping="Wrap" IsVisible="{Binding RootInputVisible}"
                   Text="Server nemá nastavený kořen struktury (ScopeSync:RootPath) — zadej kořenovou složku ručně."/>
        <TextBlock Foreground="#9CDCFE" TextWrapping="Wrap"
                   Text="{Binding NewBasePathPreview, StringFormat='Instance vznikne v: {0} (a v ní složky old/new/reports)'}"
                   IsVisible="{Binding NewBasePathPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <CheckBox Content="Založit složky old/new/reports" IsChecked="{Binding EnsureStructure}" VerticalAlignment="Center"/>
          <Button Content="Uložit" Command="{Binding SaveCreateCommand}"/>
          <Button Content="Zrušit" Command="{Binding CancelCreateCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding ValidationError}" Foreground="#C0392B" TextWrapping="Wrap"
                   IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,420">
      <DataGrid Grid.Column="0" Margin="0,0,8,0" x:CompileBindings="False" ItemsSource="{Binding Instances}"
                SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="48">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="⚙" Padding="6,2" Margin="2" ToolTip.Tip="Konfigurace (triggery a porovnávače)"
                        Command="{Binding #Root.DataContext.OpenSettingsCommand}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Akce" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="▶" ToolTip.Tip="Spustit" Padding="6,2" IsEnabled="{Binding CanRun}"
                          Command="{Binding #Root.DataContext.RunInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="➕" ToolTip.Tip="Přidat do fronty" Padding="6,2" IsEnabled="{Binding CanEnqueue}"
                          Command="{Binding #Root.DataContext.EnqueueInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏸" ToolTip.Tip="Pozastavit" Padding="6,2" IsEnabled="{Binding CanPause}"
                          Command="{Binding #Root.DataContext.PauseInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="↻" ToolTip.Tip="Obnovit" Padding="6,2" IsEnabled="{Binding CanResume}"
                          Command="{Binding #Root.DataContext.ResumeInstanceCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏹" ToolTip.Tip="Zastavit" Padding="6,2" IsEnabled="{Binding CanStop}"
                          Command="{Binding #Root.DataContext.StopInstanceCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Klíč" Binding="{Binding Instance.Key}" Width="140"/>
          <DataGridTextColumn Header="Název" Binding="{Binding Instance.Name}" Width="140"/>
          <DataGridTextColumn Header="Základní cesta" Binding="{Binding Instance.BasePath}" Width="*"/>
          <DataGridTextColumn Header="Fronta" Binding="{Binding StatusText}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
          <TextBlock Text="Vyber instanci v seznamu pro zobrazení stavu a statistik."
                     Foreground="#808080" TextWrapping="Wrap"
                     IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNull}}"/>

          <StackPanel Spacing="10" IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedInstance.Key, StringFormat='Detail instance: {0}'}" FontWeight="Bold" FontSize="16"/>

            <!-- Úprava instance -->
            <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="Úprava instance" FontWeight="Bold"/>
                <TextBox Text="{Binding EditName}" Watermark="Název"/>
                <TextBox Text="{Binding EditBasePath}" Watermark="Základní cesta"/>
                <TextBox Text="{Binding EditCredentialProfile}" Watermark="Profil přihlášení (volitelné)"/>
                <CheckBox Content="Povoleno" IsChecked="{Binding EditEnabled}"/>
                <Button Content="💾 Uložit změny" Command="{Binding SaveEditCommand}"/>
              </StackPanel>
            </Border>

            <!-- Statistiky této instance -->
            <ItemsControl ItemsSource="{Binding Stats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatGroup">
                  <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatLine">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#CCC"/>
                              <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="Bold"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Spouštěče této instance -->
            <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="Spouštěče" FontWeight="Bold"/>
                <TextBlock Foreground="#808080" TextWrapping="Wrap"
                           Text="Konfigurace triggerů a porovnávačů je dostupná přes ⚙ u řádku instance."/>
                <TextBlock Text="Žádné spouštěče." Foreground="#808080" IsVisible="{Binding !Triggers.Count}"/>
                <ItemsControl x:CompileBindings="False" ItemsSource="{Binding Triggers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Foreground="#808080" FontSize="12"
                                     Text="{Binding Status, StringFormat='Stav: {0}'}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0" Foreground="#6A9955"
                                   Text="výchozí" IsVisible="{Binding IsDefault}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Připravenost (jen pro čtení) -->
            <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10"
                    IsVisible="{Binding Readiness, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Text="Připravenost" FontWeight="Bold"/>
                <TextBlock Text="{Binding Readiness.Ready, StringFormat='Připraveno: {0}'}"/>
                <TextBlock Text="{Binding Readiness.Reachable, StringFormat='Dostupné: {0}'}"/>
                <TextBlock Text="{Binding Readiness.OldPdfCount, StringFormat='PDF ve staré verzi: {0}'}"/>
                <TextBlock Text="{Binding Readiness.NewPdfCount, StringFormat='PDF v nové verzi: {0}'}"/>
                <TextBlock Text="{Binding Readiness.Matched, StringFormat='Spárováno: {0}'}"/>
                <TextBlock Text="{Binding Readiness.OnlyInOld, StringFormat='Jen ve staré: {0}'}"/>
                <TextBlock Text="{Binding Readiness.OnlyInNew, StringFormat='Jen v nové: {0}'}"/>
                <TextBlock Text="{Binding Readiness.Error}" Foreground="#C0392B" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- Struktura složek (jen pro čtení) -->
            <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10"
                    IsVisible="{Binding Structure, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Text="Struktura složek" FontWeight="Bold"/>
                <TextBlock Text="{Binding Structure.Ok, StringFormat='V pořádku: {0}'}"/>
                <TextBlock Text="{Binding Structure.BasePath}" TextWrapping="Wrap"/>
                <ItemsControl x:CompileBindings="False" ItemsSource="{Binding Structure.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" Width="64" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding State}"/>
                        <TextBlock Text="{Binding PdfCount, StringFormat='({0} pdf)'}"
                                   Foreground="#808080"
                                   IsVisible="{Binding PdfCount, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
