<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
        xmlns:controls="using:DiffPdf.DesktopUI.Controls"
        x:Class="DiffPdf.DesktopUI.Views.FilePairDetailWindow"
        x:DataType="vm:FilePairDetailViewModel"
        Width="1100" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        FontFamily="{DynamicResource BrandFont}"
        Icon="avares://DiffPdf.DesktopUI/Assets/Brand/d3energy-icon.png"
        Title="{Binding FileName}">

  <DockPanel>
    <!-- Úzká lišta: stav · název · metriky · Uložit PDF; náhled vyplní zbytek okna. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"
                     MaxWidth="360" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"
                     IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Button Content="Kopírovat ID" Classes="ghost" Command="{Binding CopyJobIdCommand}"
                  ToolTip.Tip="{Binding JobId, StringFormat='ID úlohy: {0}'}"/>
          <Button Content="Uložit PDF" Classes="accent" Command="{Binding SaveCommand}" IsVisible="{Binding HasDiff}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusBrush}" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"
                     IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- PDF náhled přes celé okno (WebView2/Edge) -->
    <Panel Background="{DynamicResource Bg}">
      <controls:WebView2Host Source="{Binding FileUri}" IsVisible="{Binding HasDiff}"/>
      <StackPanel IsVisible="{Binding !HasDiff}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="520">
        <TextBlock Text="Pro tuto dvojici není diff k zobrazení." Foreground="{DynamicResource InkDim}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding PairError}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" TextAlignment="Center"
                   IsVisible="{Binding PairError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <TextBlock Text="{Binding ContentErrorCount, StringFormat='⚠ {0} stránek s chybou v obsahu'}" Foreground="{DynamicResource Bad}"
                   HorizontalAlignment="Center" IsVisible="{Binding HasContentErrors}"/>
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
