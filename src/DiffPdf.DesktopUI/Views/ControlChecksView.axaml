<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.ControlChecksView"
             x:DataType="vm:ControlChecksViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Automatizované kontroly" Classes="pageTitle" Margin="2,0,0,10"/>

    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <Button Content="Nová" Classes="accent" Command="{Binding NewCommand}"/>
      <Button Content="Obnovit" Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Obnovit (F5)"/>
      <Button Content="Upravit" Classes="ghost" Command="{Binding EditSelectedCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <Button Content="Spustit teď" Classes="ghost" Command="{Binding RunNowCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <Button Content="Smazat" Classes="destructive" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </WrapPanel>

    <!-- Souhrn automatizací (zdraví kontrol na první pohled) -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Summary}" Margin="0,0,0,8">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StatLine">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}"/>
            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"/>
            <TextBlock Text="{Binding Count}" Foreground="{Binding Foreground}" FontWeight="{Binding Weight}"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid ColumnDefinitions="3*,2*">
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <Panel DockPanel.Dock="Top" Height="280">
          <DataGrid x:CompileBindings="False" ItemsSource="{Binding Checks}"
                    SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Klíč" Binding="{Binding Key}" Width="140"/>
              <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="110"/>
              <DataGridTextColumn Header="Rozsah" Binding="{Binding ScopeKind}" Width="90"/>
              <DataGridTemplateColumn Header="Povoleno" Width="100" SortMemberPath="Enabled">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                      <Border Classes="badge good" IsVisible="{Binding Enabled}">
                        <TextBlock Text="Povoleno"/>
                      </Border>
                      <Border Classes="badge" IsVisible="{Binding !Enabled}">
                        <TextBlock Text="Zakázáno"/>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Výsledek" Width="100" SortMemberPath="LastOutcome">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding LastOutcome, Converter={x:Static vm:CheckOutcomeLabelConverter.Instance}}"
                               Foreground="{Binding LastOutcome, Converter={x:Static vm:CheckOutcomeBrushConverter.Instance}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Verze" Binding="{Binding Version}" Width="55"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Zatím žádné kontroly. Vytvoř první tlačítkem Nová." Foreground="{DynamicResource InkFaint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoChecks}"/>
        </Panel>

        <TextBlock DockPanel.Dock="Top" Text="Historie běhů" Classes="headline" Margin="0,10,0,6"/>
        <Panel>
          <DataGrid x:CompileBindings="False" ItemsSource="{Binding Runs}" IsReadOnly="True"
                    AutoGenerateColumns="False" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Začátek" Binding="{Binding StartedAt, Converter={x:Static vm:LocalTimeConverter.Instance}}" Width="180"/>
              <DataGridTextColumn Header="Výsledek" Binding="{Binding Outcome}" Width="90"/>
              <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Vyber kontrolu pro zobrazení historie běhů." Foreground="{DynamicResource InkFaint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"/>
          <TextBlock Text="Tato kontrola zatím neproběhla." Foreground="{DynamicResource InkFaint}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoRuns}"/>
        </Panel>
      </DockPanel>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="6">
          <TextBlock Text="Kontrola" Classes="headline"/>
          <TextBox Text="{Binding Key}" PlaceholderText="Klíč (unikátní)"/>
          <TextBox Text="{Binding Name}" PlaceholderText="Název"/>
          <TextBlock Text="Typ"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Rozsah"/>
            <TextBlock Text="ⓘ" Foreground="{DynamicResource InkFaint}" FontSize="11" VerticalAlignment="Center"
                       ToolTip.Tip="Rozsah kontroly: Global = celý server, Branch = jedna větev, Instance = jedna instance. Určuje, na co se kontrola vztahuje."/>
          </StackPanel>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Scopes}" SelectedItem="{Binding ScopeKind}"/>
          <TextBox Text="{Binding BranchKey}" PlaceholderText="Klíč větve (pro rozsah Větev/Instance)"/>
          <TextBox Text="{Binding InstanceKey}" PlaceholderText="Klíč instance (pro rozsah Instance)"/>
          <TextBox Text="{Binding Cron}" PlaceholderText="Cron (UTC, 5 polí) — má přednost"
                   ToolTip.Tip="Cron výraz, 5 polí v UTC: minuta hodina den-v-měsíci měsíc den-v-týdnu. Příklad: 0 6 * * * = každý den v 06:00 UTC; */15 * * * * = každých 15 minut. Když je vyplněn, má přednost před intervalem."/>
          <TextBlock Text="nebo interval (s)"/>
          <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="0" Increment="30"/>
          <TextBlock Text="Parametry (klíč=hodnota na řádek)"/>
          <TextBox Text="{Binding ParametersText}" AcceptsReturn="True" Height="60"
                   PlaceholderText="retentionDays=30&#x0a;rootPath=/pdfs"/>
          <TextBlock Text="Notifikační události při selhání"/>
          <CheckBox Content="Kontrola připravenosti selhala" IsChecked="{Binding EventReadinessFailed}"/>
          <CheckBox Content="Zhoršené zdraví serveru" IsChecked="{Binding EventHealthDegraded}"/>
          <CheckBox Content="Nesoulad struktury" IsChecked="{Binding EventStructureDrift}"/>
          <CheckBox Content="Kontrola se obnovila" IsChecked="{Binding EventCheckRecovered}"/>
          <CheckBox Content="Povoleno" IsChecked="{Binding Enabled}"/>
          <Button Content="Uložit kontrolu" Classes="accent" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
