<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Notifikace" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Subscriptions.Count, StringFormat='({0})'}" Foreground="#777" VerticalAlignment="Center"
                 IsVisible="{Binding !HasNoSubscriptions}"/>
      <Button Content="🔄 Obnovit" Command="{Binding RefreshCommand}" ToolTip.Tip="Obnovit (F5)"/>
      <Button Content="Nová" Command="{Binding NewCommand}"/>
      <Button Content="Upravit" Command="{Binding EditSelectedCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <Button Content="Smazat" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="#9CDCFE" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </StackPanel>

    <Grid ColumnDefinitions="*,360">
      <DataGrid Grid.Column="0" Margin="0,0,8,0" x:CompileBindings="False" ItemsSource="{Binding Subscriptions}"
                SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" Width="90"/>
          <DataGridTextColumn Header="Cíl" Binding="{Binding Target}" Width="*"/>
          <DataGridTextColumn Header="Větev" Binding="{Binding BranchKey}" Width="100"/>
          <DataGridTextColumn Header="Instance" Binding="{Binding InstanceKey}" Width="120"/>
          <DataGridTemplateColumn Header="Povoleno" Width="100" SortMemberPath="Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border CornerRadius="3" Padding="7,1" Background="#16341A" IsVisible="{Binding Enabled}">
                    <TextBlock Text="Povoleno" Foreground="#6FCF73" FontSize="12"/>
                  </Border>
                  <Border CornerRadius="3" Padding="7,1" Background="#3A3A3A" IsVisible="{Binding !Enabled}">
                    <TextBlock Text="Zakázáno" Foreground="#AAAAAA" FontSize="12"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Verze" Binding="{Binding Version}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Column="0" Margin="0,0,8,0" Text="Zatím žádné odběry. Vytvoř první tlačítkem Nová."
                 Foreground="#808080" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoSubscriptions}"/>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="6">
          <TextBlock Text="Odběr notifikací" FontWeight="Bold"/>
          <TextBlock Text="Kanál"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"/>
          <TextBox Text="{Binding Target}" PlaceholderText="Cíl (URL nebo e-mail)"/>
          <TextBlock Text="Události"/>
          <CheckBox Content="Dokončeno" IsChecked="{Binding EventCompleted}"/>
          <CheckBox Content="Porušena CI brána" IsChecked="{Binding EventGateViolated}"/>
          <CheckBox Content="Selhání" IsChecked="{Binding EventFailed}"/>
          <TextBox Text="{Binding BranchKey}" PlaceholderText="Klíč větve (volitelné)"/>
          <TextBox Text="{Binding InstanceKey}" PlaceholderText="Klíč instance (volitelné)"/>
          <CheckBox Content="Povoleno" IsChecked="{Binding Enabled}"/>
          <Button Content="Uložit odběr" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
