<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="2,0,0,10">
      <TextBlock Text="Notifikace" Classes="pageTitle"/>
      <TextBlock Text="{Binding Subscriptions.Count, StringFormat='({0})'}" Foreground="{DynamicResource InkFaint}" VerticalAlignment="Center"
                 IsVisible="{Binding !HasNoSubscriptions}"/>
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <Button Content="Nová" Classes="accent" Command="{Binding NewCommand}"/>
      <Button Content="Obnovit" Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Obnovit (F5)"/>
      <Button Content="Upravit" Classes="ghost" Command="{Binding EditSelectedCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <Button Content="Smazat" Classes="destructive" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </WrapPanel>

    <Grid ColumnDefinitions="3*,2*">
      <DataGrid Grid.Column="0" Margin="0,0,12,0" x:CompileBindings="False" ItemsSource="{Binding Subscriptions}"
                SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Kanál" Binding="{Binding Channel}" Width="90"/>
          <DataGridTextColumn Header="Cíl" Binding="{Binding Target}" Width="*"/>
          <DataGridTextColumn Header="Větev" Binding="{Binding BranchKey}" Width="100"/>
          <DataGridTextColumn Header="Instance" Binding="{Binding InstanceKey}" Width="120"/>
          <DataGridTemplateColumn Header="Povoleno" Width="100" SortMemberPath="Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border Classes="badge good" IsVisible="{Binding Enabled}">
                    <TextBlock Text="Povoleno"/>
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding !Enabled}">
                    <TextBlock Text="Zakázáno"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Verze" Binding="{Binding Version}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Column="0" Margin="0,0,12,0" Text="Zatím žádné odběry. Vytvoř první tlačítkem Nová."
                 Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoSubscriptions}"/>

      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="6">
          <TextBlock Text="Odběr notifikací" Classes="headline"/>
          <TextBlock Text="Kanál"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"/>
          <TextBox Text="{Binding Target}" PlaceholderText="Cíl (URL nebo e-mail)"/>
          <TextBlock Text="Události"/>
          <CheckBox Content="Dokončeno" IsChecked="{Binding EventCompleted}"/>
          <CheckBox Content="Dokončeno s chybami" IsChecked="{Binding EventCompletedWithErrors}"
                    ToolTip.Tip="Úloha doběhla, ale některé páry se nepodařilo porovnat (chyby)."/>
          <CheckBox Content="Porušena CI brána" IsChecked="{Binding EventGateViolated}"/>
          <CheckBox Content="Selhání" IsChecked="{Binding EventFailed}"/>
          <CheckBox Content="Zaseknutá úloha" IsChecked="{Binding EventJobStalled}"
                    ToolTip.Tip="Běžící úloha přestala dělat pokrok (watchdog ji označil za zaseknutou)."/>
          <TextBox Text="{Binding BranchKey}" PlaceholderText="Klíč větve (volitelné)"/>
          <TextBox Text="{Binding InstanceKey}" PlaceholderText="Klíč instance (volitelné)"/>
          <CheckBox Content="Povoleno" IsChecked="{Binding Enabled}"/>
          <Button Content="Uložit odběr" Classes="accent" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
