<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:controls="using:DiffPdf.DesktopUI.Controls"
             x:Class="DiffPdf.DesktopUI.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel"
             x:Name="Root">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="2,0,0,10">
      <TextBlock Text="Notifikace" Classes="pageTitle"/>
      <TextBlock Text="{Binding Rules.Count, StringFormat='({0})'}" Foreground="{DynamicResource InkFaint}" VerticalAlignment="Center"
                 IsVisible="{Binding !HasNoRules}"/>
    </StackPanel>

    <!-- E-mailová pravidla. SMTP server se nastavuje v Konfiguraci → E-mail. Obnovení je implicitní:
         znovu-klik na položku „Notifikace" v navigaci, nebo F5. -->
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <Button Content="Nové pravidlo" Classes="accent" Command="{Binding NewCommand}"/>
      <Button Content="Smazat" Classes="destructive" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </WrapPanel>

    <Grid ColumnDefinitions="3*,2*">
      <!-- Seznam pravidel -->
      <DataGrid Grid.Column="0" Margin="0,0,12,0" x:Name="RulesGrid" x:CompileBindings="False" ItemsSource="{Binding Rules}"
                SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
        <!-- Pravý klik na pravidlo: výběr řádku ho rovnou otevře v editoru vpravo, menu nese zbylé akce. -->
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Nové pravidlo" Command="{Binding NewCommand}"/>
            <Separator/>
            <MenuItem Header="🗑&#xFE0E; Smazat pravidlo…" Classes="destructive" Command="{Binding DeleteCommand}"/>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Název" Binding="{Binding DisplayName}" Width="140"/>
          <DataGridTextColumn Header="Příjemci" Binding="{Binding RecipientsSummary}" Width="*"/>
          <DataGridTextColumn Header="Rozsah" Binding="{Binding ScopeSummary}" Width="*"/>
          <DataGridTextColumn Header="Události" Binding="{Binding EventsSummary}" Width="90"/>
          <DataGridTemplateColumn Header="Aktivní" Width="100" SortMemberPath="Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border Classes="badge good" IsVisible="{Binding Enabled}"><TextBlock Text="Aktivní"/></Border>
                  <Border Classes="badge" IsVisible="{Binding !Enabled}"><TextBlock Text="Vypnuto"/></Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Column="0" Margin="0,0,12,0" Text="Zatím žádná pravidla. Vytvoř první tlačítkem „Nové pravidlo“."
                 Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoRules}"/>

      <!-- Editor pravidla -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding EditorHeading}" Classes="headline"/>

          <StackPanel Spacing="4">
            <TextBlock Text="Název (volitelný)" Classes="caption"/>
            <TextBox Text="{Binding Name}" PlaceholderText="např. QA tým — selhání alfa"/>
          </StackPanel>

          <!-- Příjemci -->
          <StackPanel Spacing="6">
            <TextBlock Text="Příjemci (e-maily)" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding NewRecipient}" PlaceholderText="adresa@firma.cz">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddRecipientCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Content="Přidat" Classes="ghost" Command="{Binding AddRecipientCommand}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Recipients}" x:CompileBindings="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="badge" Margin="0,0,6,6" Padding="9,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                      <Button Content="✕" Classes="ghost" FontSize="10" Padding="4,0" VerticalAlignment="Center"
                              Command="{Binding #Root.DataContext.RemoveRecipientCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Odebrat příjemce"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Pravidlo musí mít aspoň jednoho příjemce." Classes="caption"/>
          </StackPanel>

          <!-- Rozsah: větve + instance — multi-select dropdown (prázdný výběr = pravidlo platí všude);
               nabídka instancí se zužuje podle vybraných větví. -->
          <StackPanel Spacing="4">
            <TextBlock Text="Větve" FontWeight="SemiBold"/>
            <controls:MultiSelectDropDown ItemsSource="{Binding BranchChoices}"
                                          Summary="{Binding BranchScopeSummary}"
                                          HasSelection="{Binding HasBranchSelection}"
                                          Hint="Prázdný výběr = pravidlo platí pro všechny větve."
                                          EmptyText="Zatím nejsou žádné větve."
                                          ToolTip.Tip="Vyber větve (prázdné = všechny)"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Instance" FontWeight="SemiBold"/>
            <controls:MultiSelectDropDown ItemsSource="{Binding InstanceChoices}"
                                          Summary="{Binding InstanceScopeSummary}"
                                          HasSelection="{Binding HasInstanceSelection}"
                                          Hint="Prázdný výběr = všechny instance. Nabídka se řídí vybranými větvemi."
                                          EmptyText="Vybrané větve nemají žádné instance."
                                          ToolTip.Tip="Vyber instance (prázdné = všechny)"/>
          </StackPanel>

          <!-- Události -->
          <StackPanel Spacing="6">
            <TextBlock Text="Události — úlohy" FontWeight="SemiBold"/>
            <CheckBox Content="Dokončeno" IsChecked="{Binding EvtCompleted}"/>
            <CheckBox Content="Dokončeno s chybami" IsChecked="{Binding EvtCompletedWithErrors}"
                      ToolTip.Tip="Úloha doběhla, ale některé páry se nepodařilo porovnat."/>
            <CheckBox Content="Selhání" IsChecked="{Binding EvtFailed}"/>
            <CheckBox Content="Zaseknutá úloha" IsChecked="{Binding EvtJobStalled}"
                      ToolTip.Tip="Běžící úloha přestala dělat pokrok (watchdog)."/>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Události — server a automatizace" FontWeight="SemiBold"/>
            <CheckBox Content="Zdraví serveru zhoršeno" IsChecked="{Binding EvtHealthDegraded}"
                      ToolTip.Tip="Kritická závislost (databáze, renderer, úložiště) je degradovaná."/>
            <CheckBox Content="Připravenost selhala" IsChecked="{Binding EvtReadinessFailed}"
                      ToolTip.Tip="Vstupy instance nejsou připravené k porovnání."/>
            <CheckBox Content="Odchylka struktury" IsChecked="{Binding EvtStructureDrift}"
                      ToolTip.Tip="Složková struktura se rozchází s konfigurací."/>
            <CheckBox Content="Automatizace obnovena" IsChecked="{Binding EvtAutomationRecovered}"
                      ToolTip.Tip="Dříve selhávající automatizace opět prošla."/>
            <CheckBox Content="Automatizace opakovaně selhává" IsChecked="{Binding EvtAutomationFailing}"
                      ToolTip.Tip="Automatizace selhala tolikrát po sobě, kolik má nastavený práh eskalace (ohlásí se jednou při překročení)."/>
          </StackPanel>

          <CheckBox Content="Pravidlo aktivní" IsChecked="{Binding Enabled}"/>
          <Button Content="Uložit pravidlo" Classes="accent" Command="{Binding SaveCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
