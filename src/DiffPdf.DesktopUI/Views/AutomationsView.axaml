<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.AutomationsView"
             x:DataType="vm:AutomationsViewModel">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Automatizace" Classes="pageTitle"/>
      <TextBlock Text="Plánované i událostmi spouštěné akce — porovnání, kontroly, úklid a synchronizace."
                 Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Jediný typ obsahu → žádný vnitřní výběr; obsah dostane celou šířku (VM → View přes ViewLocator). -->
    <ContentControl Content="{Binding SelectedType.Content}"/>
  </DockPanel>
</UserControl>
