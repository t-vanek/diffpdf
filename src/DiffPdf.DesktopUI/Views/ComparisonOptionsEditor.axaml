<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.ComparisonOptionsEditor"
             x:DataType="vm:ComparisonOptionsViewModel">

  <StackPanel Spacing="6">
    <TextBlock Text="Možnosti porovnání" FontWeight="Bold"/>

    <WrapPanel>
      <StackPanel Width="150" Margin="0,0,8,6">
        <TextBlock Text="Režim"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
      </StackPanel>
      <StackPanel Width="150" Margin="0,0,8,6">
        <TextBlock Text="Přísnost"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Strictnesses}" SelectedItem="{Binding Strictness}"/>
      </StackPanel>
      <StackPanel Width="150" Margin="0,0,8,6">
        <TextBlock Text="Renderer"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Renderers}" SelectedItem="{Binding Renderer}"/>
      </StackPanel>
      <StackPanel Width="110" Margin="0,0,8,6">
        <TextBlock Text="DPI"/>
        <NumericUpDown Value="{Binding Dpi}" Minimum="1" Maximum="1200" Increment="10" FormatString="0"/>
      </StackPanel>
    </WrapPanel>

    <WrapPanel>
      <StackPanel Width="150" Margin="0,0,8,6">
        <TextBlock Text="Tolerance posunu (px)"/>
        <NumericUpDown Value="{Binding ShiftTolerance}" Minimum="0" Maximum="64" FormatString="0"/>
      </StackPanel>
      <StackPanel Width="150" Margin="0,0,8,6">
        <TextBlock Text="Vizuální práh (0–1)"/>
        <NumericUpDown Value="{Binding VisualThreshold}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.###"/>
      </StackPanel>
      <StackPanel Width="170" Margin="0,0,8,6">
        <TextBlock Text="Práh textových rozdílů (0–1)"/>
        <NumericUpDown Value="{Binding TextDifferenceThreshold}" Minimum="0" Maximum="1" Increment="0.01" FormatString="0.###"/>
      </StackPanel>
      <StackPanel Width="100" Margin="0,0,8,6">
        <TextBlock Text="Strany od"/>
        <NumericUpDown Value="{Binding PagesFrom}" Minimum="1" FormatString="0"/>
      </StackPanel>
      <StackPanel Width="100" Margin="0,0,8,6">
        <TextBlock Text="Strany do"/>
        <NumericUpDown Value="{Binding PagesTo}" Minimum="1" FormatString="0"/>
      </StackPanel>
    </WrapPanel>

    <WrapPanel>
      <StackPanel Width="160" Margin="0,0,8,6">
        <TextBlock Text="Rozložení zvýraznění"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Layouts}" SelectedItem="{Binding HighlightLayout}"/>
      </StackPanel>
      <StackPanel Width="160" Margin="0,0,8,6">
        <TextBlock Text="Styl zvýraznění"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Styles}" SelectedItem="{Binding HighlightStyle}"/>
      </StackPanel>
    </WrapPanel>

    <WrapPanel>
      <CheckBox Content="Normalizovat bílé znaky" IsChecked="{Binding NormalizeWhitespace}" Margin="0,0,12,0"/>
      <CheckBox Content="Zarovnat strany" IsChecked="{Binding AlignPages}" Margin="0,0,12,0"/>
      <CheckBox Content="Detekovat prázdné strany" IsChecked="{Binding DetectBlankPages}" Margin="0,0,12,0"/>
      <CheckBox Content="Detekovat chyby obsahu" IsChecked="{Binding DetectContentErrors}" Margin="0,0,12,0"/>
      <CheckBox Content="Vytvořit zvýrazněné PDF" IsChecked="{Binding ProduceHighlightedPdf}"/>
    </WrapPanel>

    <TextBlock Text="Ignorované textové vzory (oddělené čárkou)"/>
    <TextBox Text="{Binding IgnoreTextPatterns}"/>
    <TextBlock Text="Vzory chyb obsahu (oddělené čárkou)"/>
    <TextBox Text="{Binding ContentErrorPatterns}"/>
  </StackPanel>
</UserControl>
