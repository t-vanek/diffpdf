<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.DiscoveryView"
             x:DataType="vm:DiscoveryViewModel">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Discovery" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="Obnovit" Command="{Binding RefreshCommand}"/>
      <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock Text="Credential profily" FontWeight="Bold"/>
      <ItemsControl ItemsSource="{Binding CredentialProfiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding}"/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <DataGrid x:CompileBindings="False" ItemsSource="{Binding Shares}" IsReadOnly="True"
              AutoGenerateColumns="False" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
        <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="*"/>
        <DataGridTextColumn Header="LocalMount" Binding="{Binding LocalMountPath}" Width="200"/>
        <DataGridTextColumn Header="Creds" Binding="{Binding RequiresCredentials}" Width="80"/>
        <DataGridTextColumn Header="Popis" Binding="{Binding Description}" Width="200"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
