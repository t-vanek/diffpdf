<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.BranchesView"
             x:DataType="vm:BranchesViewModel"
             x:Name="Root">

  <DockPanel>
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Větve" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="🔄 Obnovit" Command="{Binding RefreshCommand}"/>
      <Button Content="➕ Vytvořit větev" Command="{Binding ShowCreateCommand}"/>
      <Button Content="🗑 Smazat větev" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <TextBlock Text="{Binding Info}" Foreground="#9CDCFE" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Reveal form (vytvoření) -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowCreateForm}"
            BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
      <StackPanel Spacing="8">
        <TextBlock Text="Nová větev" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="200" Text="{Binding NewKey}" PlaceholderText="Klíč (např. Alfa)"/>
          <TextBox Width="260" Text="{Binding NewName}" PlaceholderText="Název"/>
          <Button Content="Uložit" Command="{Binding SaveCreateCommand}"/>
          <Button Content="Zrušit" Command="{Binding CancelCreateCommand}"/>
        </StackPanel>
        <TextBlock Foreground="#9CDCFE" TextWrapping="Wrap"
                   Text="{Binding BranchFolderPreview, StringFormat='Složka větve vznikne v: {0}'}"
                   IsVisible="{Binding BranchFolderPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding ValidationError}" Foreground="#C0392B" TextWrapping="Wrap"
                   IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
    </Border>

    <!-- Master (seznam) + detail (stav, úprava, statistiky této větve) -->
    <Grid ColumnDefinitions="*,400">
      <DataGrid Grid.Column="0" x:CompileBindings="False"
                ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedRow}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="48">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="⚙" Padding="6,2" Margin="2" ToolTip.Tip="Konfigurace (triggery a porovnávače)"
                        Command="{Binding #Root.DataContext.OpenSettingsCommand}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Akce" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="▶" ToolTip.Tip="Spustit" Padding="6,2" IsEnabled="{Binding CanRun}"
                          Command="{Binding #Root.DataContext.RunBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="➕" ToolTip.Tip="Přidat do fronty" Padding="6,2" IsEnabled="{Binding CanEnqueue}"
                          Command="{Binding #Root.DataContext.EnqueueBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏸" ToolTip.Tip="Pozastavit" Padding="6,2" IsEnabled="{Binding CanPause}"
                          Command="{Binding #Root.DataContext.PauseBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="↻" ToolTip.Tip="Obnovit" Padding="6,2" IsEnabled="{Binding CanResume}"
                          Command="{Binding #Root.DataContext.ResumeBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏹" ToolTip.Tip="Zastavit" Padding="6,2" IsEnabled="{Binding CanStop}"
                          Command="{Binding #Root.DataContext.StopBranchCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Klíč" Binding="{Binding Branch.Key}" Width="160"/>
          <DataGridTextColumn Header="Název" Binding="{Binding Branch.Name}" Width="*"/>
          <DataGridTextColumn Header="Povoleno" Binding="{Binding Branch.Enabled}" Width="80"/>
          <DataGridTextColumn Header="Fronta" Binding="{Binding StatusText}" Width="220"/>
        </DataGrid.Columns>
      </DataGrid>

      <ScrollViewer Grid.Column="1" Margin="10,0,0,0"
                    IsVisible="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SelectedBranch.Key, StringFormat='Detail větve: {0}'}" FontWeight="Bold" FontSize="16"/>

          <!-- Úprava větve -->
          <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel Spacing="8">
              <TextBlock Text="Úprava větve" FontWeight="Bold"/>
              <TextBox Text="{Binding EditName}" Watermark="Název"/>
              <CheckBox Content="Povoleno" IsChecked="{Binding EditEnabled}"/>
              <Button Content="💾 Uložit změny" Command="{Binding SaveEditCommand}"/>
            </StackPanel>
          </Border>

          <!-- Statistiky této větve -->
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatGroup">
                <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatLine">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#CCC"/>
                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="Bold"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Souhrn spouštěčů této větve -->
          <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="Bold" Text="{Binding Triggers.Count, StringFormat='Spouštěče ({0})'}"/>
              <TextBlock Foreground="#808080" TextWrapping="Wrap"
                         Text="Konfigurace triggerů a porovnávačů je dostupná přes ⚙ u řádku větve."/>
              <TextBlock Text="Žádné spouštěče." Foreground="#808080" IsVisible="{Binding !Triggers.Count}"/>
              <ItemsControl x:CompileBindings="False" ItemsSource="{Binding Triggers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                      <TextBlock Grid.Column="1" Margin="6,0" Foreground="#808080" Text="{Binding InstanceKey}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#9CDCFE"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
