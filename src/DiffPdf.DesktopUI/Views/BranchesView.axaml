<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             xmlns:models="using:DiffPdf.Client"
             x:Class="DiffPdf.DesktopUI.Views.BranchesView"
             x:DataType="vm:BranchesViewModel"
             x:Name="Root">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}"/>
  </UserControl.KeyBindings>

  <DockPanel>
    <!-- Title -->
    <TextBlock DockPanel.Dock="Top" Text="Větve" Classes="pageTitle" Margin="2,0,0,10"/>

    <!-- Toolbar: primary action · bulk group · search. Wraps on narrow windows. Obnovení je implicitní (znovu-klik
         na položku navigace, kliknutí do řádku, nebo F5); synchronizace se řeší v Automatizaci. -->
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,10">
      <Button Content="Vytvořit větev" Classes="accent" Command="{Binding ShowCreateCommand}"/>
      <Button Content="Smazat větev" Classes="destructive" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}"/>

      <Border Width="1" Background="{DynamicResource Line}" Margin="4,3"/>

      <Button Content="Povolit" Classes="ghost" Command="{Binding EnableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Povolí všechny zaškrtnuté větve"/>
      <Button Content="Zakázat" Classes="ghost" Command="{Binding DisableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Zakáže všechny zaškrtnuté větve"/>
      <Button Content="{Binding SelectedDeleteCount, StringFormat='Smazat vybrané ({0})'}" Classes="destructive"
              Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Smaže všechny zaškrtnuté větve"/>

      <TextBox x:Name="SearchBox" Width="200" VerticalAlignment="Center" Text="{Binding SearchText}"
               PlaceholderText="Hledat (klíč/název)…" ToolTip.Tip="Hledat (Ctrl+F)"/>
      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </WrapPanel>

    <!-- Master (seznam) + detail (stav, statistiky této větve) — vytvoření i úprava jsou modální formuláře -->
    <Grid ColumnDefinitions="3*,2*">
      <DataGrid Grid.Column="0" x:Name="BranchesGrid" x:CompileBindings="False" Tapped="OnRowTapped"
                ItemsSource="{Binding BranchesView}" SelectedItem="{Binding SelectedRow}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True">
        <!-- Pravý klik na řádek: stejné akce jako tlačítka v řádku, ale bez míření na drobné ikony.
             Pravé tlačítko řádek nejdřív vybere (viz RowContextMenu.Attach v code-behind). -->
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="▸ Spustit" Command="{Binding RunBranchCommand}" CommandParameter="{Binding SelectedRow}"
                      IsEnabled="{Binding SelectedRow.CanRun, FallbackValue=False}"/>
            <MenuItem Header="+ Přidat do fronty" Command="{Binding EnqueueBranchCommand}" CommandParameter="{Binding SelectedRow}"
                      IsEnabled="{Binding SelectedRow.CanEnqueue, FallbackValue=False}"/>
            <MenuItem Header="‖ Pozastavit" Command="{Binding PauseBranchCommand}" CommandParameter="{Binding SelectedRow}"
                      IsEnabled="{Binding SelectedRow.CanPause, FallbackValue=False}"/>
            <MenuItem Header="↻ Obnovit" Command="{Binding ResumeBranchCommand}" CommandParameter="{Binding SelectedRow}"
                      IsEnabled="{Binding SelectedRow.CanResume, FallbackValue=False}"/>
            <MenuItem Header="■ Zastavit…" Command="{Binding StopBranchCommand}" CommandParameter="{Binding SelectedRow}"
                      IsEnabled="{Binding SelectedRow.CanStop, FallbackValue=False}"/>
            <Separator/>
            <MenuItem Header="✎ Upravit větev…" Command="{Binding EditBranchCommand}" CommandParameter="{Binding SelectedRow}"/>
            <MenuItem Header="⚙&#xFE0E; Konfigurace…" Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding SelectedRow}"/>
            <Separator/>
            <MenuItem Header="Kopírovat klíč" Command="{Binding CopyKeyCommand}" CommandParameter="{Binding SelectedRow}"/>
            <Separator/>
            <MenuItem Header="🗑&#xFE0E; Smazat větev…" Classes="destructive" Command="{Binding DeleteCommand}"/>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <CheckBox IsChecked="{Binding #Root.DataContext.AllSelected, Mode=TwoWay}" ToolTip.Tip="Vybrat / odznačit vše"/>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="10,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="Vybrat pro hromadné smazání"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="✎" Classes="iconBtn ghost" ToolTip.Tip="Upravit větev"
                          Command="{Binding #Root.DataContext.EditBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⚙&#xFE0E;" Classes="iconBtn ghost" ToolTip.Tip="Konfigurace (triggery a porovnávače)"
                          Command="{Binding #Root.DataContext.OpenSettingsCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Akce" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="▸" Classes="iconBtn ghost" ToolTip.Tip="Spustit" IsEnabled="{Binding CanRun}"
                          Command="{Binding #Root.DataContext.RunBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="+" Classes="iconBtn ghost" ToolTip.Tip="Přidat do fronty" IsEnabled="{Binding CanEnqueue}"
                          Command="{Binding #Root.DataContext.EnqueueBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="‖" Classes="iconBtn ghost" ToolTip.Tip="Pozastavit" IsEnabled="{Binding CanPause}"
                          Command="{Binding #Root.DataContext.PauseBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="↻" Classes="iconBtn ghost" ToolTip.Tip="Obnovit" IsEnabled="{Binding CanResume}"
                          Command="{Binding #Root.DataContext.ResumeBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="■" Classes="iconBtn ghost" ToolTip.Tip="Zastavit" IsEnabled="{Binding CanStop}"
                          Command="{Binding #Root.DataContext.StopBranchCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Klíč" Binding="{Binding Branch.Key}" Width="160"/>
          <DataGridTextColumn Header="Název" Binding="{Binding Branch.Name}" Width="*"/>
          <DataGridTextColumn Header="Instance" Binding="{Binding InstanceCount}" Width="90"/>
          <DataGridTemplateColumn Header="Aktivní" Width="110" SortMemberPath="Branch.Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border Classes="badge good" IsVisible="{Binding Branch.Enabled}">
                    <TextBlock Text="Povoleno"/>
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding !Branch.Enabled}">
                    <TextBlock Text="Zakázáno"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Fronta" Width="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Info}" IsVisible="{Binding IsActive}"/>
                  <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource InkFaint}" IsVisible="{Binding !IsActive}"/>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Prázdný stav (přes prázdnou mřížku) -->
      <TextBlock Grid.Column="0" Text="Zatím žádné větve. Vytvoř první tlačítkem „Vytvořit větev“."
                 Foreground="{DynamicResource InkFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding HasNoBranches}"/>

      <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                    IsVisible="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10">
          <ContentControl Content="{Binding SelectedBranch}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="models:Branch">
                <TextBlock Text="{Binding Key, StringFormat='Detail větve: {0}'}" Classes="headline"/>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

          <!-- Statistiky této větve -->
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatGroup">
                <Border Classes="cardStatic" Padding="12" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatLine">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Width="18" Text="{Binding Icon}" Foreground="{Binding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding Foreground}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{Binding Foreground}" FontWeight="{Binding Weight}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
