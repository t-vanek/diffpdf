<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.BranchesView"
             x:DataType="vm:BranchesViewModel"
             x:Name="Root">

  <DockPanel>
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Větve" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Content="🔄 Obnovit" Command="{Binding RefreshCommand}"/>
      <Button Content="➕ Vytvořit větev" Command="{Binding ShowCreateCommand}"/>
      <Button Content="🗑 Smazat větev" Command="{Binding DeleteCommand}"
              IsEnabled="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <Button Content="{Binding SelectedDeleteCount, StringFormat='🗑 Smazat vybrané ({0})'}"
              Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Smaže všechny zaškrtnuté větve"/>
      <Button Content="✅ Povolit" Command="{Binding EnableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Povolí všechny zaškrtnuté větve"/>
      <Button Content="🚫 Zakázat" Command="{Binding DisableSelectedCommand}" IsEnabled="{Binding CanDeleteSelected}"
              ToolTip.Tip="Zakáže všechny zaškrtnuté větve"/>
      <TextBox Width="200" VerticalAlignment="Center" Text="{Binding SearchText}"
               PlaceholderText="Hledat (klíč/název)…"/>
      <TextBlock Text="{Binding Info}" Foreground="#9CDCFE" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Error}" Foreground="#C0392B" VerticalAlignment="Center"/>
      <ProgressBar IsIndeterminate="True" Width="100" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
    </StackPanel>

    <!-- Master (seznam) + detail (stav, statistiky této větve) — vytvoření i úprava jsou modální formuláře -->
    <Grid ColumnDefinitions="*,400">
      <DataGrid Grid.Column="0" x:CompileBindings="False"
                ItemsSource="{Binding BranchesView}" SelectedItem="{Binding SelectedRow}"
                IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="40" CanUserSort="False">
            <DataGridTemplateColumn.Header>
              <CheckBox IsChecked="{Binding #Root.DataContext.AllSelected, Mode=TwoWay}" ToolTip.Tip="Vybrat / odznačit vše"/>
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Margin="10,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="Vybrat pro hromadné smazání"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="86">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="✏" Padding="6,2" Margin="2" ToolTip.Tip="Upravit větev"
                          Command="{Binding #Root.DataContext.EditBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⚙" Padding="6,2" Margin="2" ToolTip.Tip="Konfigurace (triggery a porovnávače)"
                          Command="{Binding #Root.DataContext.OpenSettingsCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Akce" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="▶" ToolTip.Tip="Spustit" Padding="6,2" IsEnabled="{Binding CanRun}"
                          Command="{Binding #Root.DataContext.RunBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="➕" ToolTip.Tip="Přidat do fronty" Padding="6,2" IsEnabled="{Binding CanEnqueue}"
                          Command="{Binding #Root.DataContext.EnqueueBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏸" ToolTip.Tip="Pozastavit" Padding="6,2" IsEnabled="{Binding CanPause}"
                          Command="{Binding #Root.DataContext.PauseBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="↻" ToolTip.Tip="Obnovit" Padding="6,2" IsEnabled="{Binding CanResume}"
                          Command="{Binding #Root.DataContext.ResumeBranchCommand}" CommandParameter="{Binding}"/>
                  <Button Content="⏹" ToolTip.Tip="Zastavit" Padding="6,2" IsEnabled="{Binding CanStop}"
                          Command="{Binding #Root.DataContext.StopBranchCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Klíč" Binding="{Binding Branch.Key}" Width="160"/>
          <DataGridTextColumn Header="Název" Binding="{Binding Branch.Name}" Width="*"/>
          <DataGridTextColumn Header="Instance" Binding="{Binding InstanceCount}" Width="90"/>
          <DataGridTemplateColumn Header="Povoleno" Width="110" SortMemberPath="Branch.Enabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Border CornerRadius="3" Padding="7,1" Background="#16341A" IsVisible="{Binding Branch.Enabled}">
                    <TextBlock Text="Povoleno" Foreground="#6FCF73" FontSize="12"/>
                  </Border>
                  <Border CornerRadius="3" Padding="7,1" Background="#3A3A3A" IsVisible="{Binding !Branch.Enabled}">
                    <TextBlock Text="Zakázáno" Foreground="#AAAAAA" FontSize="12"/>
                  </Border>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Fronta" Width="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StatusText}" Foreground="#9CDCFE" IsVisible="{Binding IsActive}"/>
                  <TextBlock Text="{Binding StatusText}" Foreground="#808080" IsVisible="{Binding !IsActive}"/>
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Prázdný stav (přes prázdnou mřížku) -->
      <TextBlock Grid.Column="0" Text="Zatím žádné větve. Vytvoř první tlačítkem ➕ Vytvořit větev."
                 Foreground="#808080" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding HasNoBranches}"/>

      <ScrollViewer Grid.Column="1" Margin="10,0,0,0"
                    IsVisible="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SelectedBranch.Key, StringFormat='Detail větve: {0}'}" FontWeight="Bold" FontSize="16"/>

          <!-- Statistiky této větve -->
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatGroup">
                <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatLine">
                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                            <TextBlock Grid.Column="0" Width="18" Text="{Binding Icon}" Foreground="{Binding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding Foreground}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{Binding Foreground}" FontWeight="{Binding Weight}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
