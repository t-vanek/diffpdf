<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.EmailSettingsView"
             x:DataType="vm:EmailSettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="14" Margin="4" MaxWidth="560" HorizontalAlignment="Left">
      <TextBlock Text="E-mail (SMTP)" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="Server a odesílací účet pro e-mailové notifikace. Příjemce a události se nastavují v sekci Notifikace."
                 Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>

      <Border Classes="cardStatic" Padding="14">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="SMTP server" Classes="caption"/>
            <TextBox Text="{Binding Host}" PlaceholderText="smtp.firma.cz"/>
          </StackPanel>

          <WrapPanel>
            <StackPanel Width="160" Margin="0,0,12,8" Spacing="4">
              <TextBlock Text="Port" Classes="caption"/>
              <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0"/>
            </StackPanel>
            <CheckBox Content="Použít SSL/TLS" IsChecked="{Binding UseSsl}" VerticalAlignment="Bottom" Margin="0,0,0,12"
                      ToolTip.Tip="Implicitní SSL na portu 465, jinak STARTTLS. Vypnuto = nešifrovaně."/>
          </WrapPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Uživatel (volitelné)" Classes="caption"/>
            <TextBox Text="{Binding Username}" PlaceholderText="přihlašovací jméno"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Heslo" Classes="caption"/>
            <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="{Binding PasswordPlaceholder}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Odesílatel (From)" Classes="caption"/>
            <TextBox Text="{Binding FromAddress}" PlaceholderText="diffpdf@firma.cz"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Jméno odesílatele (volitelné)" Classes="caption"/>
            <TextBox Text="{Binding FromName}" PlaceholderText="DiffPDF"/>
          </StackPanel>

          <Button Content="Uložit nastavení" Classes="accent" Command="{Binding SaveCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>
      </Border>

      <Border Classes="cardStatic" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Test odeslání" FontWeight="SemiBold"/>
          <TextBlock Text="Pošle testovací e-mail s uloženým nastavením (ulož nejdřív případné změny)."
                     Foreground="{DynamicResource InkDim}" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding TestTo}" PlaceholderText="adresa pro test…"/>
            <Button Grid.Column="1" Content="Poslat testovací e-mail" Classes="ghost" Command="{Binding SendTestCommand}" IsEnabled="{Binding !IsBusy}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Historie doručení (outbox): co se odeslalo, co se znovu zkouší a co skončilo nedoručené — s důvodem
           a možností poslat znovu. Notifikace se nikdy tiše neztratí; selhání SMTP je tu vidět. -->
      <Border Classes="cardStatic" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Historie doručení" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Border Padding="7,1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Bad}"
                      BorderThickness="1" CornerRadius="{DynamicResource RadPill}"
                      IsVisible="{Binding HasDeadLetters}">
                <TextBlock FontSize="11" Foreground="{DynamicResource Bad}" VerticalAlignment="Center"
                           Text="{Binding DeadLetterCount, StringFormat='{}{0} nedoručených'}"/>
              </Border>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Jen problémy" IsChecked="{Binding OnlyProblemDeliveries}"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Zobrazit jen selhaná a nedoručená odeslání."/>
            <Button Grid.Column="2" Content="Obnovit" Classes="ghost" Command="{Binding RefreshDeliveriesCommand}"
                    IsEnabled="{Binding !IsBusy}"/>
          </Grid>

          <TextBlock Text="Zatím žádná odeslání." Foreground="{DynamicResource InkFaint}"
                     IsVisible="{Binding HasNoDeliveries}"/>

          <ItemsControl ItemsSource="{Binding Deliveries}" MaxHeight="420">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeliveryRowViewModel">
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadSm}" Padding="10,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding EventLabel}" FontSize="12"/>
                        <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource InkDim}" FontSize="12"
                                   IsVisible="{Binding Scope, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Delivery.CreatedAt, Converter={x:Static vm:LocalTimeConverter.Instance}, ConverterParameter='dd.MM HH:mm:ss'}"
                                   Foreground="{DynamicResource InkFaint}" FontSize="11"/>
                        <TextBlock Text="{Binding RecipientsText}" Foreground="{DynamicResource InkDim}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip.Tip="{Binding RecipientsText}"/>
                        <TextBlock Text="{Binding Delivery.RuleName}" Foreground="{DynamicResource InkFaint}" FontSize="11"
                                   IsVisible="{Binding Delivery.RuleName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Bad}" FontSize="11"
                                 TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Poslat znovu" Classes="ghost" FontSize="12" VerticalAlignment="Center"
                            IsVisible="{Binding CanResend}"
                            Command="{Binding $parent[ItemsControl].((vm:EmailSettingsViewModel)DataContext).ResendDeliveryCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Info}" TextWrapping="Wrap"
                 IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <ProgressBar IsIndeterminate="True" Width="120" Height="4" HorizontalAlignment="Left" IsVisible="{Binding IsBusy}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
