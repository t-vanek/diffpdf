<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffPdf.DesktopUI.ViewModels"
             x:Class="DiffPdf.DesktopUI.Views.WatchesView"
             x:DataType="vm:WatchesViewModel">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Watches" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <ComboBox Width="150" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}">
        <ComboBox.ItemTemplate><DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Key}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Width="150" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
        <ComboBox.ItemTemplate><DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding Key}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Width="130">
        <TextBlock Text="StabilitySeconds"/>
        <NumericUpDown Value="{Binding StabilitySeconds}" Minimum="1" Maximum="3600" FormatString="0"/>
      </StackPanel>
      <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
      <Button Content="Set" Command="{Binding SetCommand}"/>
      <Button Content="Get" Command="{Binding GetCommand}"/>
      <Button Content="Delete" Command="{Binding DeleteCommand}"/>
      <Button Content="Obnovit" Command="{Binding RefreshCommand}"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6">
      <Run Text="{Binding Info}" Foreground="#9CDCFE"/>
      <Run Text="{Binding Error}" Foreground="#C0392B"/>
    </TextBlock>

    <DataGrid x:CompileBindings="False" ItemsSource="{Binding Watches}" IsReadOnly="True"
              AutoGenerateColumns="False" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Branch" Binding="{Binding BranchKey}" Width="150"/>
        <DataGridTextColumn Header="Instance" Binding="{Binding InstanceKey}" Width="150"/>
        <DataGridTextColumn Header="Stability" Binding="{Binding StabilitySeconds}" Width="90"/>
        <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
        <DataGridTextColumn Header="LastTriggered" Binding="{Binding LastTriggeredAt}" Width="200"/>
        <DataGridTextColumn Header="v" Binding="{Binding Version}" Width="50"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
