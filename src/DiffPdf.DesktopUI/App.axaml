<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DiffPdf.DesktopUI"
             x:Class="DiffPdf.DesktopUI.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Design tokens (colour + geometry). Single source of truth; FluentTheme reads
         SystemAccentColor / ControlCornerRadius from here. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DiffPdf.DesktopUI/Theme/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- Shared component styles (typography scale, card, badge, button variants…). -->
        <StyleInclude Source="avares://DiffPdf.DesktopUI/Theme/Controls.axaml" />

        <!-- Reusable animations (applied via Classes="fadeIn|pulse" or an Ellipse.spinner). -->

        <!-- One-shot fade-in entrance for panels that appear (e.g. the "not connected" card). -->
        <Style Selector="Control.fadeIn">
            <Style.Animations>
                <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Gentle "breathing" pulse — signals a live indicator (e.g. the connected dot). -->
        <Style Selector="Control.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Rotating ring spinner for loading states. -->
        <Style Selector="Ellipse.spinner">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="{DynamicResource Info}"/>
            <Setter Property="StrokeThickness" Value="2.5"/>
            <Setter Property="StrokeDashArray" Value="5,15"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0.0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360.0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
