<?xml version="1.0" encoding="utf-8"?>
<!--
  DiffPdf normally restores everything from nuget.org. The D3Soft.Tisk integration
  (src/DiffPdf.Tisk) additionally needs the private D3S Azure Artifacts feed for the
  D3Soft.* print-SOA packages. Package source mapping keeps the two worlds separate:
  only D3Soft.*/AlphaFS.* are fetched from D3SFeed, everything else from nuget.org.
  This means an unreachable D3SFeed (off the D3S corporate network) only breaks the
  D3Soft.* restore, not the whole solution. CI/deploy that builds DiffPdf.Tisk must
  reach d3s-devops and authenticate (Azure Artifacts credential provider).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="D3SFeed" value="https://d3s-devops/D3S/_packaging/D3SFeed/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="D3SFeed">
      <package pattern="D3Soft.*" />
      <package pattern="AlphaFS.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
